[Unit]
Description=WealthOS API
After=network.target postgresql.service

[Service]
User=root
WorkingDirectory=/opt/wlthos/backend
Environment="DATABASE_URL=postgresql://wealthos:WealthOS_DB_2026!@localhost/wealthosdb"
EnvironmentFile=/opt/wlthos/backend/.env
ExecStart=/opt/wlthos/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
